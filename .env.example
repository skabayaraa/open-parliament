# Copy to .env and fill in. Never commit .env.
PORT=3000
# Behind nginx / a hosting proxy: number of proxy hops, so rate limits see the visitor's IP.
# TRUST_PROXY=1
# RATE_PER_MIN=300
CHIMEGE_TTS_TOKEN=paste-your-token-here

# Request format (defaults shown). Change only if the Chimege manual says otherwise.
# CHIMEGE_TTS_URL=https://api.chimege.com/v1.2/synthesize
# CHIMEGE_TOKEN_HEADER=Token
# CHIMEGE_CONTENT_TYPE=plain/text
# CHIMEGE_VOICE_HEADER=voice-id
# CHIMEGE_SPEED_HEADER=speed
# CHIMEGE_PITCH_HEADER=pitch
# CHIMEGE_PITCH=

# Voices (4 male + 5 female on your plan). Put the real ids from the manual here.
# Until you've confirmed the ids, set CHIMEGE_SEND_VOICE=false to use Chimege's default voice.
CHIMEGE_SEND_VOICE=false
# CHIMEGE_VOICES=[{"id":"FEMALE1","label":"Эмэгтэй 1"},{"id":"MALE1","label":"Эрэгтэй 1"}]
# CHIMEGE_DEFAULT_VOICE=FEMALE1

# Values sent to Chimege for the page's slow / normal / fast setting
# CHIMEGE_SPEED_SLOW=0.8
# CHIMEGE_SPEED_NORMAL=1
# CHIMEGE_SPEED_FAST=1.2
